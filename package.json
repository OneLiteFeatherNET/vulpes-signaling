{
  "name": "vulpes-signaling",
  "version": "0.1.0",
  "description": "PeerJS signaling server for Blockbench edit sessions, run as a sidecar next to Vulpes-Backend.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run typecheck && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@types/cors": "2.8.19",
    "peer": "1.0.2"
  }
}
